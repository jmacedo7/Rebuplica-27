# Rebuplica 27 - environment variables (example).
# Copy this file to `.env` for local development.
# NEVER commit the real `.env` or real credentials. The file is git-ignored.
#
# Every variable below is read by `src/config/env.ts`; `npm run config:check`
# fails fast (exit code 1) when a required variable is missing or malformed.

# development | test | production
NODE_ENV=development
# Bind address. Use 0.0.0.0 inside containers/platforms that proxy to the process.
HOST=127.0.0.1
PORT=3000
# debug | info | warn | error | silent
LOG_LEVEL=info

# PostgreSQL connection string. Required in every environment: the runtime never
# falls back to in-memory storage.
DATABASE_URL=postgres://rebuplica:change-me@localhost:5432/rebuplica
# disable | require | no-verify  (managed providers usually require TLS)
DATABASE_SSL=disable

# Required in production, at least 32 characters, never a documented placeholder.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=rebuplica-27
JWT_AUDIENCE=rebuplica-api
# Access token lifetime in seconds (60..86400).
ACCESS_TOKEN_TTL_SECONDS=900

# Comma separated list of allowed browser origins for CORS, or empty to disable
# cross-origin requests. Wildcards are rejected on purpose: the API is authenticated.
# Example: https://app.rebuplica27.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=

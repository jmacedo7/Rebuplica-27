# República 27 - environment variables (example).
# Copy this file to `.env` for local development.
# NEVER commit the real `.env` or real credentials. The file is git-ignored.
#
# Every variable below is read by `src/config/env.ts`; `npm run config:check`
# fails fast (exit code 1) when a required variable is missing or malformed.

# development | test | production
NODE_ENV=development
# Bind address. Use 0.0.0.0 inside containers/platforms that proxy to the process.
HOST=127.0.0.1
PORT=3000
# debug | info | warn | error | silent
LOG_LEVEL=info

# PostgreSQL connection string. Required in every environment: the runtime never
# falls back to in-memory storage.
DATABASE_URL=postgres://republica:change-me@localhost:5432/republica
# disable | require | no-verify  (managed providers usually require TLS)
DATABASE_SSL=disable

# Required in production, at least 32 characters, never a documented placeholder.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=republica-27
JWT_AUDIENCE=republica-api
# Access token lifetime in seconds (60..86400).
ACCESS_TOKEN_TTL_SECONDS=900

# Comma separated list of allowed browser origins for CORS, or empty to disable
# cross-origin requests. Wildcards are rejected on purpose: the API is authenticated.
# Example: https://app.republica27.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# --- Gemini (Google AI) ---
# Absent key = integration pending: the API answers AI_NOT_CONFIGURED until set.
# Create one in https://aistudio.google.com/apikey and register it in the backend
# environment (never in the frontend, never in the repository).
GEMINI_API_KEY=
# Gemini model identifier used for generateContent calls.
# Default: gemini-flash-latest. gemini-2.5-flash foi descontinuado pelo Google para
# novas chaves (HTTP 404). Quando o modelo principal esta sobrecarregado (503/429)
# ou foi desativado (404), o backend tenta automaticamente gemini-flash-lite-latest.
GEMINI_MODEL=gemini-flash-latest
# Provider request timeout in milliseconds (1000..60000). Default: 20000
GEMINI_TIMEOUT_MS=20000
# Requests per player per UTC day served with the shared project key (1..10000).
# Players with their own key are not limited by this. Default: 20
GEMINI_DAILY_LIMIT=20
# Master secret (min 32 chars) that encrypts players' personal Gemini keys in the
# database (AES-256-GCM). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Empty = personal keys disabled. Never rotate without re-saving players' keys.
AI_KEY_ENCRYPTION_SECRET=
